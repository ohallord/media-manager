# Copy to .env and fill in. ./setup.sh writes this file for you.
# Never commit .env.

# Signs session tokens. Generate with: openssl rand -hex 32
JWT_SECRET=

# One-time bootstrap admin. No default: if INITIAL_ADMIN_PASSWORD is empty,
# no admin account is created. You must change it on first login.
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD=

WEB_PORT=8088

# Library folders to scan (comma-separated).
MEDIA_DIRECTORIES=/media/Movies,/media/TvShows

# Watcher moves: JSON array of {"from_dir","to_dir","type"}.
SOURCE_DIRECTORIES=[{"from_dir":"/downloads/movies","to_dir":"/media/Movies","type":"movie"},{"from_dir":"/downloads/tv","to_dir":"/media/TvShows","type":"tv"}]

# Optional: Postgres instead of SQLite.
# USE_POSTGRES=true
# POSTGRES_URI=postgresql+asyncpg://<user>:<password>@<host>:5432/mediadb
